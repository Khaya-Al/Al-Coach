(function () {
  var cfg = window.SITE || {};

  /* ---------- Contact links (every page) ---------- */
  document.querySelectorAll("[data-wa]").forEach(function (a) {
    a.href = "https://wa.me/" + cfg.whatsapp + "?text=" + encodeURIComponent(a.getAttribute("data-wa"));
    a.target = "_blank";
    a.rel = "noopener";
  });
  document.querySelectorAll("[data-mail]").forEach(function (a) {
    var subject = a.getAttribute("data-mail");
    a.href = "mailto:" + cfg.email + "?subject=" + encodeURIComponent(subject) +
      "&body=" + encodeURIComponent("Hi Khaya,\n\n");
  });
  document.querySelectorAll("[data-email-text]").forEach(function (el) { el.textContent = cfg.email; });

  /* ---------- Laptop to book morph (home page only) ---------- */
  var scene = document.getElementById("scene");
  if (!scene) return;
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  var el = {
    screen: document.getElementById("screen"),
    base: document.getElementById("base"),
    cover: document.getElementById("cover"),
    cpScreen: document.getElementById("cpScreen"),
    cpBase: document.getElementById("cpBase"),
    spine: document.getElementById("spine"),
    code: document.getElementById("code"),
    pages: document.getElementById("pages"),
    capA: document.getElementById("capA"),
    capB: document.getElementById("capB"),
    hint: document.getElementById("hint")
  };

  // Each shape: [x1,y1, x2,y2, x3,y3, x4,y4] as a laptop and as a book.
  var S = {
    screen: { a: [150, 40, 450, 40, 450, 250, 150, 250], b: [50, 70, 300, 92, 300, 300, 50, 278] },
    base:   { a: [90, 262, 510, 262, 550, 306, 50, 306], b: [300, 92, 550, 70, 550, 278, 300, 300] },
    cover:  { a: [90, 262, 510, 262, 550, 306, 50, 306], b: [34, 58, 566, 58, 566, 304, 34, 304] }
  };
  var C = {
    screen: { a: [14, 42, 59], b: [255, 255, 255] },
    base:   { a: [201, 214, 221], b: [255, 255, 255] }
  };

  function lerp(a, b, t) { return a + (b - a) * t; }
  function pts(s, t) {
    var out = [];
    for (var i = 0; i < 8; i += 2) out.push(lerp(s.a[i], s.b[i], t).toFixed(1) + "," + lerp(s.a[i + 1], s.b[i + 1], t).toFixed(1));
    return out.join(" ");
  }
  function rgb(c, t) {
    return "rgb(" + [0, 1, 2].map(function (i) { return Math.round(lerp(c.a[i], c.b[i], t)); }).join(",") + ")";
  }
  function smooth(x, lo, hi) {
    var t = Math.min(1, Math.max(0, (x - lo) / (hi - lo)));
    return t * t * (3 - 2 * t);
  }

  function render(m) {
    var screen = pts(S.screen, m), base = pts(S.base, m);
    el.screen.setAttribute("points", screen);
    el.cpScreen.setAttribute("points", screen);
    el.base.setAttribute("points", base);
    el.cpBase.setAttribute("points", base);
    el.cover.setAttribute("points", pts(S.cover, m));
    el.screen.setAttribute("fill", rgb(C.screen, m));
    el.base.setAttribute("fill", rgb(C.base, m));
    el.spine.setAttribute("opacity", smooth(m, 0.7, 1).toFixed(2));
    el.code.setAttribute("opacity", (1 - smooth(m, 0.1, 0.55)).toFixed(2));
    el.pages.setAttribute("opacity", smooth(m, 0.45, 0.9).toFixed(2));
    el.capA.style.opacity = (1 - smooth(m, 0.2, 0.5)).toFixed(2);
    el.capB.style.opacity = smooth(m, 0.55, 0.85).toFixed(2);
  }

  function update() {
    var r = scene.getBoundingClientRect();
    var total = scene.offsetHeight - window.innerHeight;
    var p = Math.min(1, Math.max(0, -r.top / total));
    var m = reduce ? (p > 0.5 ? 1 : 0) : smooth(p, 0.12, 0.8);
    render(m);
    el.hint.style.opacity = p > 0.05 ? 0 : 1;
  }

  var ticking = false;
  window.addEventListener("scroll", function () {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(function () { update(); ticking = false; });
    }
  }, { passive: true });
  window.addEventListener("resize", update);
  update();
})();
